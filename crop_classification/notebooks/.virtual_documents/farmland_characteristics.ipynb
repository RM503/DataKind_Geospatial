def smoothing(df: pd.DataFrame) -> pd.DataFrame:
    # Apply Savitsky-Golay filter
    df = df.copy()

    df["ndvi"] = df.groupby("uuid")["ndvi"].transform(
        lambda x: savgol_filter(x, 7, 3) if len(x) >= 7 else x
    )
    df["ndmi"] = df.groupby("uuid")["ndmi"].transform(
        lambda x: savgol_filter(x, 7, 3) if len(x) >= 7 else x
    )

    return df


