def plot_peak_dist_geographical(gdf: gpd.GeoDataFrame) -> None:
    import matplotlib.colors as mcolors

    years = gdf["ndvi_peak_year"].unique().tolist()

    unique_vals = sorted(gdf["number_of_peaks_per_farm"].dropna().unique())
    colors = ["red", "blue", "green", "purple", "orange"] 
    cmap = ListedColormap(colors[:len(unique_vals)])
    bounds = np.arange(len(colors) + 1)  # Boundaries for each color
    norm = mcolors.BoundaryNorm(bounds, cmap.N)

    sm = plt.cm.ScalarMappable(norm=norm, cmap=cmap)
    sm.set_array([])    
    
    fig, ax = plt.subplots(1, len(years), figsize=(15, 8), sharey=True)

    for idx, year in enumerate(years):
        gdf[gdf["ndvi_peak_year"]==year].plot(
            column="number_of_peaks_per_farm",
            cmap=cmap, 
            ax=ax[idx]
        )
        ax[idx].set_xlabel("Longitude", fontsize=10)
        if year == years[0]:
            ax[idx].set_ylabel("Latitude", fontsize=10)
        ax[idx].set_title(f"{year}", fontsize=10)

    #cbar_ax = fig.add_axes([0.15, 0.1, 0.7, 0.03])
    cbar = fig.colorbar(sm, ax=ax, orientation='horizontal', shrink=0.5, aspect=30)
    cbar.set_label("Number of NDVI peaks")
    plt.show()


