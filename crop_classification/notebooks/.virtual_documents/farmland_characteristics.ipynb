def max_ndmi_polygons(df: pd.DataFrame, gdf: gpd.GeoDataFrame) -> gpd.GeoDataFrame:
    gdf_merged = gpd.GeoDataFrame(
        df.merge(gdf, on="uuid", how="left"),
        geometry="geometry",
        crs=gdf.crs
    )

    gdf_merged = gdf_merged[gdf_merged["ndmi_max"] > 0]

    gdf_agg = gdf_merged.groupby("uuid").agg({
        "ndmi_max": "mean",
        "geometry": "first"
    }).reset_index()

    gdf_agg = gpd.GeoDataFrame(gdf_agg, geometry="geometry", crs=gdf.crs)

    vmin = gdf_merged["ndmi_max"].min()
    vmax = gdf_merged["ndmi_max"].max()
    cmap = "turbo_r"

    m = gdf_agg.explore(
        column="ndmi_max",
        cmap=cmap,
        vmin=vmin,
        vmax=vmax,
        tiles="CartoDB positron",
        legend=True,
        tooltip=["uuid", "ndmi_max"]
    )

    display(m)

    return gdf_agg


