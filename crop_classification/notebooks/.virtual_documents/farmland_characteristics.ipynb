def negbinomial_glm(df: pd.DataFrame, n: int):

    model = smf.glm(
        formula="uuid_count ~ C(ndvi_peak_year)", data=df[df["number_of_peaks_per_farm"]==n],
        family=sm.families.NegativeBinomial()
    ).fit()

    print(model.summary())
    

